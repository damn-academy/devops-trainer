{
  "name": "devops-trainer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DevOps Trainer: an interactive in-browser textbook and hands-on trainer (RU + EN).",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "fetch:v86": "node scripts/fetch-v86.mjs",
    "build:lab-image": "node scripts/build-lab-image.mjs",
    "prebuild": "node scripts/fetch-v86.mjs --optional && node scripts/build-learn.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "build:templates": "node scripts/build-templates.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:v86": "V86_INTEGRATION=1 vitest run tests/v86-integration.test.ts",
    "test:v86-lab": "V86_LAB=1 vitest run tests/v86-lab-integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:v86": "E2E_V86=1 playwright test e2e/real-lab.spec.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "build:lab-snapshots": "node scripts/build-lab-snapshots.mjs",
    "measure:lab-snapshots": "node scripts/measure-lab-snapshots.mjs",
    "lint:explainers": "node scripts/lint-explainers.mjs",
    "build:share": "node scripts/build-share.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@replit/codemirror-vim": "6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "idb": "^8.0.4",
    "ts-fsrs": "^5.4.2",
    "v86": "0.5.473",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "exceljs": "^4.4.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
